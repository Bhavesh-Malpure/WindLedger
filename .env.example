# Elexon BMRS API Base URL
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Day-Ahead Decision Cutoff Defaults
DEFAULT_CUTOFF_HOUR_UTC=11
DEFAULT_CUTOFF_DAY_OFFSET=1

# Cache / Request Settings
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5
CACHE_TTL_SECONDS=3600

# Fixture Mode (set to true to force local fixture mode, otherwise automatic fallback on upstream failure)
FORCE_FIXTURE_MODE=false
