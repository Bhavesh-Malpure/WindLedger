# Elexon Insights API base URL
ELEXON_API_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Keep false for live-source verification. Set true only for an intentional fixture demo.
FORCE_FIXTURE_MODE=false

# Default false prevents silent fallback to unverified fixture data.
# Only enable if the frontend clearly labels fixture responses.
ALLOW_FIXTURE_FALLBACK=false

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=3
